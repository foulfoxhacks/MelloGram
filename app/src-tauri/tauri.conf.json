{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelloGram",
  "version": "0.1.0",
  "identifier": "app.mellogram.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MelloGram",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCONFIG/wallpapers/*",
            "$APPCACHE/media/*"
          ],
          "deny": []
        }
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Customisable Telegram client",
    "longDescription": "MelloGram is a customizable Telegram client with a plugin manager, themes, QuickCSS, wallpapers and workspaces.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "publisher": "FoulFoxHacks",
    "copyright": "Copyright \u00a9 FoulFoxHacks \u00b7 GPL-3.0-or-later",
    "homepage": "https://mellogram.foulfoxhacks.dev",
    "license": "GPL-3.0-or-later",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "6f1d3b0e-6c8a-4f7e-9d2b-5a4e2c9b7d11"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
